        "\n",
        "# -----------------------------------------------------------\n",
        "# 🔹 2B. NORMS (vector length) + COSINE SIMILARITY\n",
        "# -----------------------------------------------------------\n",
        "# sqrt(sum of squares)\n",
        "print('L2 norm  ||a||_2 :', np.linalg.norm(a))\n",
        " # sum of absolute values\n",
        "print('L1 norm  ||a||_1 :', np.linalg.norm(a, 1))\n",
        " # max absolute value\n",
        "print('Linf norm        :', np.linalg.norm(a, np.inf))\n",
        "\n",
        "# Cosine similarity: the angle between vectors, ignoring magnitude\n",
        "def cosine(u, v):\n",
        "    return np.dot(u, v) / (np.linalg.norm(u) * np.linalg.norm(v))\n",
        "\n",
        "print('cosine(a, b)     :', round(cosine(a, b), 3))"
